---
import { site } from '../site';
---

<footer class="border-t border-ink/10">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-10 text-sm text-muted sm:flex-row sm:justify-between sm:px-6">
    <p>
      © {new Date().getFullYear()} {site.name} · {site.location}
      <span class="km" lang="km">{site.locationKm}</span>
    </p>
    <p>
      {site.hours} · <a href={site.phoneLink} class="font-medium text-ink underline underline-offset-4 hover:text-sun">{site.phone}</a>
      <span class="km" lang="km">{site.hoursKm}</span>
    </p>
  </div>
</footer>
