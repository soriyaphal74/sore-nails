---
// The homepage. Each <section> below is one band of the page — ask the AI to
// add, remove, or reorder them. Every `km` field / class="km" line is the Khmer
// caption shown under the English.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import Ornament from '../components/Ornament.astro';
import { site } from '../site';

// PRICES — change names and prices here. `extra: true` shows the price as
// an add-on ("+$1–3 extra").
const priceLists = [
  {
    icon: '💅',
    title: 'Hand nails',
    titleKm: 'ក្រចកដៃ',
    items: [
      { name: 'Basic Manicure', nameKm: 'ថែក្រចកដៃធម្មតា', price: '$3' },
      { name: 'Regular Nail Polish', nameKm: 'លាបថ្នាំក្រចកធម្មតា', price: '$3' },
      { name: 'Gel Polish', nameKm: 'លាបថ្នាំជែល', price: '$5' },
      { name: 'Gel Polish Removal', nameKm: 'លុបថ្នាំជែល', price: '$2' },
      { name: 'Gel Extensions', nameKm: 'បន្តក្រចកជែល', price: '$10–15' },
      { name: 'Soft Gel Tips', nameKm: 'បន្តក្រចកសូហ្វជែល', price: '$8–12' },
      { name: 'French Nail Design', nameKm: 'រចនាក្រចកបែបបារាំង', price: '$7–10' },
      { name: 'Simple Nail Art', nameKm: 'គំនូរក្រចកសាមញ្ញ', price: '$1–3', extra: true },
      { name: 'Advanced Nail Art', nameKm: 'គំនូរក្រចកកម្រិតខ្ពស់', price: '$3–8', extra: true },
      { name: 'Nail Repair', nameKm: 'ជួសជុលក្រចក', price: '$1–2', per: 'nail', perKm: 'ក្រចក' },
    ],
  },
  {
    icon: '🦶',
    title: 'Foot nails',
    titleKm: 'ក្រចកជើង',
    items: [
      { name: 'Basic Pedicure', nameKm: 'ថែក្រចកជើងធម្មតា', price: '$4' },
      { name: 'Regular Toenail Polish', nameKm: 'លាបថ្នាំក្រចកជើងធម្មតា', price: '$3' },
      { name: 'Gel Toenail Polish', nameKm: 'លាបថ្នាំជែលក្រចកជើង', price: '$5' },
      { name: 'Gel Polish Removal', nameKm: 'លុបថ្នាំជែល', price: '$2' },
      { name: 'French Toenail Design', nameKm: 'រចនាក្រចកជើងបែបបារាំង', price: '$7' },
      { name: 'Simple Toenail Art', nameKm: 'គំនូរក្រចកជើងសាមញ្ញ', price: '$1–3', extra: true },
      { name: 'Foot Spa + Pedicure', nameKm: 'ស្ប៉ាជើង + ថែក្រចកជើង', price: '$8–12' },
      { name: 'Foot Scrub + Massage', nameKm: 'ដុសស្បែកជើង + ម៉ាស្សា', price: '$5–8' },
    ],
  },
];

// The Facebook account for the "Book on Facebook" button.
const bookFacebook = site.facebook.find((fb) => fb.name === 'Ah Soriya') ?? site.facebook[0];

const gallery = [
  { src: '/images/nails-gold.jpg', alt: 'Long almond nails with gold foil edges and glitter', label: 'Gold Design' },
  { src: '/images/nails-navy.jpg', alt: 'Navy and white nails with stars and polka dots', label: 'Nail Art' },
];
---

<Base>
  <Header />
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden bg-gradient-to-b from-leaf/80 via-paper to-paper">
      <div class="pointer-events-none absolute -top-32 -right-32 size-96 rounded-full bg-rose/30 blur-3xl"></div>
      <div class="pointer-events-none absolute top-1/2 -left-40 size-80 rounded-full bg-sun/15 blur-3xl"></div>
      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 pt-10 pb-16 sm:px-6 sm:pt-16 lg:grid-cols-2">
        <div class="text-center">
          <h1 class="sr-only">{site.name}, nail salon in Siem Reap</h1>
          <Logo class="mx-auto w-64 drop-shadow-xl sm:w-80" />
          <p class="mt-6 text-xs font-semibold tracking-[0.35em] text-sun">SIEM REAP · CAMBODIA</p>
          <p class="mt-3 font-script text-4xl text-gold sm:text-5xl">Modern &amp; elegant nail art</p>
          <p class="km text-lg text-muted" lang="km">ការរចនាក្រចក ទំនើប និងប្រណីត។</p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href={site.phoneLink} class="rounded-full bg-gradient-to-r from-brand via-sun to-brand px-6 py-3 font-semibold text-white shadow-lg shadow-sun/30 hover:brightness-110">
              📞 Call {site.phone}
            </a>
            <a href="#prices" class="rounded-full bg-white px-6 py-3 font-semibold ring-1 ring-sun/50 hover:bg-leaf">
              See prices <span lang="km" class="font-khmer font-normal">មើលតម្លៃ</span>
            </a>
          </div>
          <p class="mt-5 text-sm text-muted">
            🕗 {site.hours}
            <span class="km" lang="km">{site.hoursKm}</span>
          </p>
        </div>

        <!-- Two photos in arch frames -->
        <div class="relative mx-auto flex w-full max-w-md justify-center gap-4">
          <div class="aspect-[3/4] w-1/2 -rotate-3 overflow-hidden rounded-t-full rounded-b-2xl border-4 border-white shadow-xl ring-1 ring-sun">
            <img src="/images/nails-gold.jpg" alt="Long almond nails with gold foil edges and glitter" class="size-full object-cover" />
          </div>
          <div class="mt-10 aspect-[3/4] w-1/2 rotate-3 overflow-hidden rounded-t-full rounded-b-2xl border-4 border-white shadow-xl ring-1 ring-sun">
            <img src="/images/nails-navy.jpg" alt="Navy and white nails with stars and polka dots" class="size-full object-cover" />
          </div>
        </div>
      </div>
    </section>

    <!-- Prices -->
    <section id="prices" class="scroll-mt-20 bg-leaf/50 py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="text-center font-display text-4xl font-semibold text-gold sm:text-5xl">
          Prices
          <span class="km" lang="km">តម្លៃ</span>
        </h2>
        <Ornament />
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {
            priceLists.map((list) => (
              <div class="rounded-3xl bg-white p-6 shadow-xl shadow-rose/10 ring-1 ring-sun/40 sm:p-8">
                <h3 class="flex items-center gap-3 font-display text-2xl font-bold text-brand">
                  <span class="text-3xl">{list.icon}</span>
                  <span>
                    {list.title}
                    <span class="km" lang="km">{list.titleKm}</span>
                  </span>
                </h3>
                <ul class="mt-6 divide-y divide-dashed divide-sun/40">
                  {list.items.map((item) => (
                    <li class="flex items-start justify-between gap-4 py-3">
                      <span>
                        <span class="font-semibold">{item.name}</span>
                        <span class="km text-muted" lang="km">{item.nameKm}</span>
                      </span>
                      <span class="shrink-0 text-right">
                        <span class="font-display text-xl font-extrabold text-sun lining-nums">
                          {item.extra && '+'}{item.price}
                        </span>
                        {item.extra && (
                          <span class="block text-xs text-muted">
                            extra · <span lang="km">បន្ថែម</span>
                          </span>
                        )}
                        {item.per && (
                          <span class="block text-xs text-muted">
                            per {item.per} · <span lang="km">ក្នុងមួយ{item.perKm}</span>
                          </span>
                        )}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Gallery -->
    <section id="gallery" class="scroll-mt-20 py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="text-center font-display text-4xl font-semibold text-gold sm:text-5xl">
          Our work
          <span class="km" lang="km">ស្នាដៃរបស់យើង</span>
        </h2>
        <Ornament />
        <div class="mx-auto mt-10 grid max-w-3xl gap-6 sm:grid-cols-2">
          {
            gallery.map((g) => (
              <figure class="overflow-hidden rounded-3xl bg-white shadow-lg ring-1 ring-ink/5">
                <img src={g.src} alt={g.alt} class="aspect-[4/5] w-full object-cover" loading="lazy" />
                <figcaption class="px-5 py-3 text-center font-semibold text-brand">{g.label}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Booking: big buttons that open a chat or a call with us. -->
    <section id="book" class="scroll-mt-20 bg-leaf/50 py-16">
      <div class="mx-auto max-w-2xl px-4 sm:px-6">
        <h2 class="text-center font-display text-4xl font-semibold text-gold sm:text-5xl">
          Book now
          <span class="km" lang="km">កក់ឥឡូវនេះ</span>
        </h2>
        <Ornament />
        <p class="mt-3 text-center text-muted">
          Fill in the form and we get your booking on Telegram right away. We will message or call you to confirm.
          <span class="km" lang="km">បំពេញទម្រង់ ហើយយើងនឹងទទួលបានការកក់របស់អ្នកតាម Telegram ភ្លាមៗ។ យើងនឹងផ្ញើសារ ឬហៅទូរសព្ទទៅអ្នក ដើម្បីបញ្ជាក់។</span>
        </p>

        <!-- Booking form: sent to /api/book (worker/index.ts), which sends it to our Telegram. -->
        <form id="booking" class="mt-8 grid gap-5 rounded-3xl bg-white p-6 shadow-xl shadow-rose/10 ring-1 ring-sun/40 sm:grid-cols-2 sm:p-8">
          <label class="block">
            <span class="font-semibold">Your name <span class="km text-muted" lang="km">ឈ្មោះរបស់អ្នក</span></span>
            <input name="name" required maxlength="80" autocomplete="name" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3" />
          </label>
          <label class="block">
            <span class="font-semibold">Your phone <span class="km text-muted" lang="km">លេខទូរសព្ទរបស់អ្នក</span></span>
            <input name="phone" type="tel" required maxlength="30" autocomplete="tel" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3" />
          </label>
          <label class="block sm:col-span-2">
            <span class="font-semibold">Which service? <span class="km text-muted" lang="km">សេវាកម្មណា?</span></span>
            <select name="service" required class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3">
              <option value="">Choose… / ជ្រើសរើស…</option>
              {
                priceLists.map((list) => (
                  <optgroup label={`${list.title} · ${list.titleKm}`}>
                    {list.items.map((item) => (
                      <option value={`${item.name} (${list.title})`}>
                        {item.name} — {item.extra ? '+' : ''}{item.price}
                      </option>
                    ))}
                  </optgroup>
                ))
              }
            </select>
          </label>
          <label class="block">
            <span class="font-semibold">Day <span class="km text-muted" lang="km">ថ្ងៃ</span></span>
            <input name="date" type="date" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3" />
          </label>
          <label class="block">
            <span class="font-semibold">Time <span class="km text-muted" lang="km">ម៉ោង</span> <span class="text-sm font-normal text-muted">(8am – 9pm)</span></span>
            <input name="time" type="time" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3" />
          </label>
          <label class="block sm:col-span-2">
            <span class="font-semibold">Color or design idea? <span class="km text-muted" lang="km">ពណ៌ ឬគំនិតរចនា?</span></span>
            <textarea name="notes" rows="3" maxlength="500" placeholder="e.g. pink gel with gold stars" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3"></textarea>
          </label>
          <!-- Hidden from people. Robots fill it in, so the server ignores those. -->
          <input name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px] h-0 w-0 opacity-0" />

          <button type="submit" class="rounded-full bg-gradient-to-r from-brand via-sun to-brand px-6 py-4 text-lg font-semibold text-white hover:brightness-110 disabled:opacity-60 sm:col-span-2">
            📩 Send booking <span lang="km" class="font-khmer font-normal">ផ្ញើការកក់</span>
          </button>
          <p id="booking-status" role="status" class="hidden rounded-xl p-4 text-center sm:col-span-2"></p>
        </form>

        <p class="mt-10 text-center font-semibold text-brand">
          Or contact us directly
          <span class="km font-normal text-muted" lang="km">ឬទាក់ទងយើងដោយផ្ទាល់</span>
        </p>
        <div class="mt-4 grid gap-4 rounded-3xl bg-white p-6 shadow-xl shadow-rose/10 ring-1 ring-sun/40 sm:p-8">
          <a href={site.telegram} target="_blank" rel="noopener" class="flex flex-wrap items-center justify-center gap-x-3 rounded-full bg-[#229ED9] px-6 py-4 text-lg font-semibold text-white hover:opacity-90">
            ✈️ Book on Telegram <span lang="km" class="font-khmer font-normal">កក់តាម Telegram</span>
          </a>
          <a href={site.phoneLink} class="flex flex-wrap items-center justify-center gap-x-3 rounded-full bg-gradient-to-r from-brand via-sun to-brand px-6 py-4 text-lg font-semibold text-white hover:brightness-110">
            📞 Call {site.phone} <span lang="km" class="font-khmer font-normal">ហៅទូរសព្ទ</span>
          </a>
          <a href={bookFacebook.link} target="_blank" rel="noopener" class="flex flex-wrap items-center justify-center gap-x-3 rounded-full bg-[#1877F2] px-6 py-4 text-lg font-semibold text-white hover:opacity-90">
            💬 Book on Facebook <span lang="km" class="font-khmer font-normal">កក់តាម Facebook</span>
          </a>
          <p class="text-center text-sm text-muted">
            🕗 {site.hours} · Walk-ins welcome
            <span class="km" lang="km">{site.hoursKm} · ស្វាគមន៍ការដើរចូល</span>
          </p>
        </div>
      </div>
    </section>

    <!-- Contact and visit -->
    <section id="visit" class="scroll-mt-20 bg-brand py-16 text-paper">
      <div class="mx-auto grid max-w-5xl items-center gap-10 px-4 sm:px-6 md:grid-cols-[1fr_auto]">
        <div>
          <h2 class="font-display text-3xl font-bold sm:text-4xl">
            Contact &amp; visit
            <span class="km" lang="km">ទំនាក់ទំនង និងមកលេង</span>
          </h2>
          <ul class="mt-8 space-y-5 text-lg">
            <li>
              <a href={site.phoneLink} class="flex items-start gap-4 hover:text-leaf">
                <span class="text-2xl">📞</span>
                <span><b>{site.phone}</b> <span class="km text-paper/70" lang="km">ទូរសព្ទមកកក់</span></span>
              </a>
            </li>
            <li>
              <a href={site.telegram} class="flex items-start gap-4 hover:text-leaf" target="_blank" rel="noopener">
                <span class="text-2xl">✈️</span>
                <span><b>Telegram: {site.telegramName}</b> <span class="km text-paper/70" lang="km">ផ្ញើសារមកយើងតាម Telegram</span></span>
              </a>
            </li>
            <li class="flex items-start gap-4">
              <span class="text-2xl">💬</span>
              <span>
                <b>Facebook:</b>{" "}
                {site.facebook.map((fb, i) => (
                  <>
                    {i > 0 && <span class="text-paper/50"> or </span>}
                    <a href={fb.link} class="font-bold underline underline-offset-4 hover:text-leaf" target="_blank" rel="noopener">{fb.name}</a>
                  </>
                ))}
                <span class="km text-paper/70" lang="km">ផ្ញើសារមកយើងតាម Facebook</span>
              </span>
            </li>
            <li class="flex items-start gap-4">
              <span class="text-2xl">📍</span>
              <span><b>{site.location}</b> <span class="km text-paper/70" lang="km">{site.locationKm}</span></span>
            </li>
            <li class="flex items-start gap-4">
              <span class="text-2xl">🕗</span>
              <span><b>{site.hours}</b> <span class="km text-paper/70" lang="km">{site.hoursKm}</span></span>
            </li>
          </ul>
          <p class="mt-8 inline-block rounded-full border border-white px-5 py-2 text-sm font-semibold tracking-widest text-white">
            WALK-INS WELCOME
          </p>
        </div>

        <!-- KHQR payment code -->
        <div class="mx-auto text-center">
          <img src="/images/khqr.png" alt="KHQR code to pay SORÉ Nails" class="w-52 rounded-2xl ring-4 ring-white" loading="lazy" />
          <p class="mt-3 text-sm font-semibold tracking-widest text-white">SCAN TO PAY</p>
          <p class="km text-paper/70" lang="km">ស្កេនដើម្បីបង់ប្រាក់</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  // Sends the booking form to /api/book. The server (worker/index.ts) passes
  // it on to the salon's Telegram.
  const form = document.getElementById('booking') as HTMLFormElement;
  const status = document.getElementById('booking-status')!;
  const button = form.querySelector('button[type=submit]') as HTMLButtonElement;

  function show(kind: 'ok' | 'error', html: string) {
    status.innerHTML = html;
    status.className = `rounded-xl p-4 text-center sm:col-span-2 ${kind === 'ok' ? 'bg-leaf' : 'bg-red-50 text-red-800'}`;
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    button.disabled = true;
    try {
      const response = await fetch('/api/book', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      if (!response.ok) throw new Error(String(response.status));
      form.reset();
      show(
        'ok',
        '✅ Thank you! We got your booking. We will contact you soon to confirm.<br><span lang="km">✅ អរគុណ! យើងបានទទួលការកក់របស់អ្នកហើយ។ យើងនឹងទាក់ទងអ្នកឆាប់ៗ ដើម្បីបញ្ជាក់។</span>',
      );
    } catch {
      show(
        'error',
        'Sorry, the booking did not send. Please use Telegram or call us below.<br><span lang="km">សុំទោស ការកក់មិនបានផ្ញើទេ។ សូមប្រើ Telegram ឬហៅទូរសព្ទមកយើងខាងក្រោម។</span>',
      );
    } finally {
      button.disabled = false;
    }
  });
</script>
